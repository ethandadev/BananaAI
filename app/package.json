{
  "name": "llm-desktop",
  "version": "0.1.0",
  "description": "Desktop chat interface for a locally trained language model",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "dev.local.llm",
    "productName": "LLM",
    "files": ["main.js", "preload.js", "renderer/**/*"],
    "win": { "target": "nsis" }
  }
}
